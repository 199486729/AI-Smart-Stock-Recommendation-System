# Flask 会话签名密钥，请替换为随机长字符串
FLASK_SECRET_KEY=replace-with-a-random-secret
# 正式分析页面路径，不要包含前导斜杠
ASHARE_PATH=ashare

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-database-password
MYSQL_DATABASE=alphamind_trader

# Anthropic 兼容接口
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=replace-with-your-api-token
ANTHROPIC_MODEL=claude-sonnet-4-6

# 可选：Tushare 数据源
TUSHARE_TOKEN=
